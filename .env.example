# --- Public (browser) — inlined into the client bundle, safe to expose ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# --- Server-only — NEVER prefix these with VITE_ ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
# Bypasses RLS. Server functions / server routes only.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_PROJECT_ID="your-project-id"
# Lovable AI Gateway key used by /api/public/chat. Provisioned automatically on
# Lovable; set manually on Vercel/Netlify.
LOVABLE_API_KEY="your-lovable-ai-gateway-key"

# --- Deployment target (set by the platform build command, not in .env) ---
# DEPLOY_TARGET=lovable | vercel | netlify
