# ---------------------------------------------------------------------------
# Speedex Signages — environment variables
#
# On Lovable these are injected automatically.
# On Vercel / Netlify they must be added manually in the project dashboard
# BEFORE the build runs (the VITE_* values are inlined at build time).
# ---------------------------------------------------------------------------

# Build-time, public (safe to expose in the browser bundle)
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Runtime, server-only — NEVER prefix these with VITE_
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
LOVABLE_API_KEY="<lovable-ai-gateway-key>"

# Deployment target — selects the Nitro preset.
#   (unset) / lovable -> Cloudflare (Lovable hosting)
#   vercel            -> Nitro vercel preset  (.vercel/output)
#   netlify           -> Nitro netlify preset
# Already baked into the build command in vercel.json / netlify.toml.
# DEPLOY_TARGET="vercel"
